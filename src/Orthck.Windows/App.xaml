<Application x:Class="Orthck.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#F6F8F9"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#EEF2F4"/>
    <SolidColorBrush x:Key="Accent" Color="#30616E"/>
    <SolidColorBrush x:Key="Line" Color="#D7DFE3"/>
    <SolidColorBrush x:Key="Muted" Color="#65757D"/>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,3,0,10"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,3,0,10"/>
      <Setter Property="MinHeight" Value="35"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="DataGrid"><Setter Property="RowHeight" Value="33"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E5EAED"/><Setter Property="AlternatingRowBackground" Value="#F7FAFB"/></Style>
  </Application.Resources>
</Application>
