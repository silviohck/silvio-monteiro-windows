<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Orthck.Windows</AssemblyName>
    <RootNamespace>Orthck.Windows</RootNamespace>
    <ApplicationIcon>Recursos\Orthck.ico</ApplicationIcon>
    <Product>Orthck</Product>
    <Description>Orthck — documentos clínicos</Description>
    <!-- Tema Fluent do WPF (visual do Windows 11, claro e escuro). -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orthck.Core\Orthck.Core.csproj" />
    <Resource Include="Recursos\Orthck.png" />
    <!-- O WPF não importa System.IO por padrão (por causa de System.Windows.Shapes.Path, que não é usado aqui). -->
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
