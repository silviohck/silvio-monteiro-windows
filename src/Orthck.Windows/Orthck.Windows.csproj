<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Orthck.Windows</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Não importar System.Windows.Forms globalmente: Button e Application pertencem ao WPF. -->
    <Using Remove="System.Windows.Forms" />
    <ProjectReference Include="..\Orthck.Core\Orthck.Core.csproj" />
  </ItemGroup>
</Project>
