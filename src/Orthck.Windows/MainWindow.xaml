<Window x:Class="Orthck.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Orthck — Windows" Width="1200" Height="770" MinWidth="1020" MinHeight="650" Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,23,16,17">
          <TextBlock Text="Orthck" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
          <TextBlock Text="Documentos clínicos · Windows" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="15">
          <Button Content="Importar dados do Mac…" Click="ImportMac_Click"/>
          <TextBlock x:Name="DataPath" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="1,8,0,0"/>
        </StackPanel>
        <ListBox x:Name="Navigation" BorderThickness="0" Background="Transparent" SelectionChanged="Navigation_SelectionChanged" Margin="8,0" FontSize="14">
          <ListBoxItem Content="Gerar documento" Padding="13,11"/>
          <ListBoxItem Content="Fila de impressão" Padding="13,11"/>
          <ListBoxItem Content="Pacientes" Padding="13,11"/>
          <ListBoxItem Content="Locais de atendimento" Padding="13,11"/>
          <ListBoxItem Content="Modelos" Padding="13,11"/>
          <ListBoxItem Content="Histórico" Padding="13,11"/>
          <ListBoxItem Content="CID-10" Padding="13,11"/>
          <ListBoxItem Content="SIGTAP (SUS)" Padding="13,11"/>
          <ListBoxItem Content="TUSS" Padding="13,11"/>
        </ListBox>
      </DockPanel>
    </Border>
    <ContentControl Grid.Column="1" x:Name="PageHost" Margin="27,21,27,24"/>
  </Grid>
</Window>
